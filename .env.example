# Copier en .env puis adapter. Ne JAMAIS versionner .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
SITE_URL=http://localhost:8000
SITE_NAME=Modulis Profils

# Docker : PostgreSQL et Redis (les noms d'hôte sont ceux des services compose)
DATABASE_URL=postgres://modulis:modulis@db:5432/modulis_profils
CACHE_URL=rediscache://redis:6379/0
REDIS_URL=redis://redis:6379/1
HUEY_CLASS=huey.RedisHuey

# Codes de connexion (OTP) par WhatsApp ou SMS (ADR-0009). Les canaux s'activent dans le centre de
# contrôle (/gestion/) ; un canal n'est proposé que s'il est AUSSI configuré ici. Sans aucun canal
# configuré, en dev (DJANGO_DEBUG=True), le code s'affiche dans la console (`make logs`).
OTP_ALLOWED_PREFIXES=+237
OTP_HMAC_KEY=change-me-too
# Passerelle SMS (agrégateur local) : canal « SMS via passerelle ». ConsoleSmsBackend = dev seulement.
SMS_BACKEND=apps.accounts.sms.ConsoleSmsBackend

# WhatsApp Cloud API (Meta) : jeton d'un utilisateur système (permanent), identifiant du numéro
# expéditeur, modèle d'authentification approuvé avec bouton « copier le code ».
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_LANGUAGE=fr

# Firebase Authentication (fournisseur « Téléphone ») : configuration web PUBLIQUE de l'application
# (console Firebase > Paramètres du projet > Vos applications). Aucune clé de compte de service.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=

# Cloudflare Turnstile (vide = désactivé en dev)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# kliz : notifications d'indexation (production uniquement)
KLIZ_ENABLED=False
KLIZ_INDEXNOW_KEY=
KLIZ_GSC_SITE=
KLIZ_GSC_SERVICE_ACCOUNT_FILE=

ANALYTICS_SALT=change-me-as-well
# Adresse de l'administration. En PRODUCTION : adresse secrète obligatoire, avec un segment aléatoire d'au moins
# 12 lettres et chiffres (ex. gestion-7k2m9q4x8p3z/), sinon le serveur refuse de démarrer. Voir docs/SECURITE-ADMIN.md.
ADMIN_URL=gestion/
# Double authentification (TOTP) obligatoire pour l'équipe sur l'administration (ADR-0010).
# False accepté en développement SEULEMENT : la production refuse de démarrer sans elle.
STAFF_2FA_REQUIRED=True

# Informations légales (/mentions-legales, /cgu, /confidentialite). Vide = ligne masquée ; en production,
# le contrôle système legal.W001 signale les champs d'identité manquants.
LEGAL_ENTITY_NAME=Modulis Tech
LEGAL_FORM=
LEGAL_RCCM=
LEGAL_NIU=
LEGAL_ADDRESS=
LEGAL_EMAIL=hello@modulis.tech
LEGAL_PHONE=+237 6 78 23 96 36
LEGAL_PUBLICATION_DIRECTOR=
LEGAL_PRIVACY_EMAIL=
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
LEGAL_COURT_CITY=Douala

# Sauvegardes HORS de Docker (service « backup », docs/SAUVEGARDES.md).
# Dossier de l'hôte qui reçoit les sauvegardes. En production : un autre disque que celui des volumes Docker,
# ex. /srv/sauvegardes/modulis ; sous WSL on peut viser un disque Windows : /mnt/d/modulis-sauvegardes
BACKUP_DIR=./backups
# Heure locale (Africa/Douala) de la sauvegarde quotidienne ; alerte si la dernière a plus de N heures.
BACKUP_TIME=02:30
BACKUP_MAX_AGE_HOURS=26
# Rétention : 7 quotidiennes, 4 hebdomadaires (dimanche), 12 mensuelles (le 1er), 10 manuelles.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12
BACKUP_KEEP_MANUAL=10
# Chiffrement AES-256 (gpg) des fichiers sauvegardés. OBLIGATOIRE en production (BACKUP_REQUIRE_ENCRYPTION=1).
# Conserver la phrase secrète HORS du serveur (gestionnaire de mots de passe) : sans elle, rien n'est restaurable.
BACKUP_PASSPHRASE=
BACKUP_REQUIRE_ENCRYPTION=0
# Copie hors site facultative (rclone) : nom d'un « remote » configuré dans RCLONE_CONFIG_DIR/rclone.conf.
RCLONE_REMOTE=
RCLONE_CONFIG_DIR=./docker/backup/rclone

# Super-admin d'ÉVALUATION (make superadmin) : mot de passe FIXE, 32 caractères minimum, double
# authentification demandée à la 1re connexion. À SUPPRIMER avant la mise en ligne :
# make superadmin delete=1 (après avoir créé votre propre super-admin avec make admin).
BOOTSTRAP_ADMIN_PHONE=+237699000000
BOOTSTRAP_ADMIN_PASSWORD=
